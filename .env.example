# Configuración local. Copia este archivo a .env; no subas .env al repositorio.
# URL desde Docker Compose:
DATABASE_URL=postgresql+psycopg://appointments:appointments@appointments-db:5432/appointments_db
# URL desde el host (PostgreSQL expuesto en localhost:5433):
# DATABASE_URL=postgresql+psycopg://appointments:appointments@localhost:5433/appointments_db

ENVIRONMENT=dev
LOG_LEVEL=INFO

# JWT HS256 compartido con kenko-auth. Appointments solo valida access tokens.
JWT_ALGORITHM=HS256
JWT_SECRET=change-me-dev-only
JWT_PUBLIC_KEY=
JWT_ISSUER=kenko.auth
JWT_AUDIENCE=kenko-api
# Tolerancia de reloj entre kenko-auth y appointments (segundos, aplicada a exp/iat).
JWT_LEEWAY_SECONDS=120

MIN_HOURS_BEFORE_CANCEL_OR_RESCHEDULE=24
MAX_DAYS_AHEAD_TO_SCHEDULE=90

# log | eventbridge
EVENT_PUBLISHER=log
EVENT_BUS_NAME=kenko-dev-bus
AWS_REGION=us-east-1
# Vacío usa AWS real. No guardes credenciales AWS en este archivo.
AWS_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID y AWS_SECRET_ACCESS_KEY deben configurarse fuera del repositorio.

# Worker que consume ProfileCreated desde SQS (regla kenko-dev-profile-to-appointments).
PROFILE_QUEUE_NAME=kenko-dev-appointments-profile
# Opcional: si se fija, el worker lo usa directo sin llamar GetQueueUrl.
PROFILE_QUEUE_URL=
SQS_WAIT_TIME_SECONDS=20
SQS_MAX_MESSAGES=10
SQS_VISIBILITY_TIMEOUT=30

# Modo local opción 1 (API y worker fuera de Docker, solo la base en Docker):
# 1. Usa la DATABASE_URL del host (línea 5, descomentarla).
# 2. Cambia EVENT_PUBLISHER a eventbridge para enviar eventos reales al bus.
# Las credenciales AWS salen de ~/.aws; nunca poner claves aquí.
