# Configuración local. Copia este archivo a .env; no subas .env al repositorio.
# URL desde Docker Compose:
DATABASE_URL=postgresql+psycopg://appointments:appointments@appointments-db:5432/appointments_db
# URL desde el host (PostgreSQL expuesto en localhost:5433):
# DATABASE_URL=postgresql+psycopg://appointments:appointments@localhost:5433/appointments_db

ENVIRONMENT=dev
LOG_LEVEL=INFO

# JWT de desarrollo; en producción configura el algoritmo y la clave correspondientes.
JWT_ALGORITHM=HS256
JWT_SECRET=change-me-dev-only
JWT_PUBLIC_KEY=
JWT_ISSUER=
JWT_AUDIENCE=

# IDs locales disponibles en la futura consola; separados por comas, 5 caracteres alfanuméricos.
DEMO_USER_IDS=USR01,USR02

MIN_HOURS_BEFORE_CANCEL_OR_RESCHEDULE=24
MAX_DAYS_AHEAD_TO_SCHEDULE=90

# log | eventbridge
EVENT_PUBLISHER=log
EVENT_BUS_NAME=kenko-dev-bus
AWS_REGION=us-east-1
# Vacío usa AWS real. No guardes credenciales AWS en este archivo.
AWS_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID y AWS_SECRET_ACCESS_KEY deben configurarse fuera del repositorio.
